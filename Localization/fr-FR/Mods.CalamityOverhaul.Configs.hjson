CWRServerConfig: {
	DisplayName: Paramétrage du contenu

	WeaponOverhaul: {
		Label: Refonte des armes
		Tooltip:
			'''
			L’activation modifiera la plupart des armes.
			[c/FF0000:Pour une expérience optimale du contenu de Calamity, veuillez l'activer !]
			'''
	}

	ScreenVibration: {
        Label: Effet de vibration de l'écran pour les attaques spéciales.
        Tooltip: Si activé, cela provoquera des vibrations de l'écran lors de certaines attaques, ce qui peut intensifier les impacts.
    }

	MurasamaSpaceFragmentationBool: {
		Label: Effet de fragmentation de l'écran pour la fin de la technique de Murasama
		Tooltip:
			'''
			Activé par défaut, Murasama crée un effet de bris d'écran lorsqu'il utilise sa technique finale pour améliorer la sensation de coup
			Désactiver cette option supprime ces effets spéciaux selon vos préférences.
			'''
	}

	DomainConciseDisplay: {
		Label: Affichage minimal du domaine
		Tooltip: Désactivé par défaut. Lorsque cette option est activée, la plupart des effets visuels du domaine sont masqués.
	}

	Headers: {
		CWRSystem: Paramètres système de Calamity Overhaul
		CWRWeapon: Paramètres des armes de Calamity Overhaul
		CWRUI: Paramètres d'interface de Calamity Overhaul
		CWRWorldGen: Paramètres de génération du monde
	}

	LensEasing: {
		Label: Adoucissement de la caméra
		Tooltip: Lorsqu'activé, les déplacements rapides sur de longues distances adoucissent les mouvements de caméra afin d'éviter toute sensation d'inconfort.
	}

	WeaponHandheldDisplay: {
		Label: Affichage des armes portatives
		Tooltip:
			'''
			Lorsqu'activé, la plupart des armes disposeront d'animations de tenue et d'actions spéciales.
			Cette fonctionnalité a une priorité très élevée et remplacera la plupart des animations portatives des mods tiers.
			Activé par défaut, et pour une meilleure expérience visuelle, l'auteur recommande de ne pas le désactiver.
			'''
	}

	BowArrowDraw: {
		Label: Animation dynamique des flèches d'arc
		Tooltip:
			'''
			Lorsqu'un joueur attaque avec un arc, une animation dynamique des flèches correspondantes est affichée en temps réel.
			Activé par défaut, peut être ajusté selon les préférences personnelles.
			'''
	}

	EnableCasingsEntity: {
		Label: Activer les douilles physiques
		Tooltip: Si vous trouvez les douilles éparpillées gênantes, désactiver cette option peut être une bonne idée.
	}

	WeaponLazyRotationAngle: {
		Label: Mise à jour de l'angle d'inertie des armes
		Tooltip:
			'''
			Lorsqu'activé, l'animation d'utilisation des armes portatives se rapproche davantage du jeu vanilla,
			où la direction du personnage ne change qu'une seule fois lors du tir.
			'''
	}

	BiologyOverhaul: {
		Label: Refonte du comportement biologique [c/06e33f:(expérimental)]
		Tooltip:
			'''
			[c/c20909:Inachevé]
			Activé par défaut, modifie le comportement de l'IA de certaines créatures, notamment les BossAI dans le module de difficulté.
			Cela peut considérablement augmenter la difficulté du jeu et peut être désactivé selon vos préférences.
			'''
	}

	EnableSwordLight: {
		Label: Activer les effets lumineux des épées
		Tooltip:
			'''
			Activé par défaut, de nombreuses épées bénéficieront d'effets lumineux éclatants.
			Dans la plupart des cas, cela rendra le jeu encore plus impressionnant.
			'''
	}

	MuraUIStyleType: {
		Label: Sélection du style d'interface Mura
		Tooltip:
			'''
			Style 1 : Raffiné - Flottant au-dessus de la tête
			Style 2 : Raffiné - Compact
			Style 3 : Classique - Flottant au-dessus de la tête
			Style 4 : Classique - Compact
			Style 5 : Masqué
			'''
	}

	MuraPosStyleType: {
		Label: Sélection de la position de l'interface Mura
		Tooltip:
			'''
			Préréglage 1 : En bas à droite
			Préréglage 2 : En bas à gauche
			Préréglage 3 : En haut au centre
			'''
	}

	ShowReloadingProgressUI: {
		Label: Afficher la progression du rechargement
		Tooltip: Lorsque cette option est activée, la progression du chargement des munitions est affichée.
	}

	QuestLog: {
		Label: Guide du journal de quêtes
		Tooltip:
			'''
			Lorsqu'activé, le journal de quêtes vous guidera dans la progression du jeu.
			Vous pouvez accéder à l'interface des quêtes via le Livre de quêtes, l'inventaire ou un raccourci clavier afin de consulter vos quêtes actuelles.
			Activé par défaut. Le désactiver supprime toute assistance liée aux quêtes.
			'''
	}

	DialogueBox_Scale_Value: {
		Label: Taille de la boîte de dialogue
		Tooltip: Ajuste la taille globale de la boîte de dialogue.
	}

	GenWindGrivenGenerator: {
		Label: Générer des générateurs éoliens
		Tooltip: Place des structures de générateurs alimentés par le vent à travers le monde.
	}

	GenWGGCollector: {
		Label: Générer des avant-postes de pilleur 
		Tooltip: Fait apparaître aléatoirement des structures hostiles de pilleur dans le monde. Ce paramètre ne prend effet que dans les mondes Légendaires.
	}

	GenJunkmanBase: {
		Label: Générer la base du Ferrailleur
		Tooltip: Fait apparaître une forteresse de pilleur dans les terres désolées ou dans les souterrain.
	}

	GenRocketHut: {
		Label: Générer une cabane-fusée
		Tooltip: Génère une mystérieuse cabane contenant des composants de fusée ou des reliques technologiques.
	}

	GenSylvanOutpost: {
		Label: Générer un avant-poste sylvestre
		Tooltip: Fait apparaître des avant-postes d'elfes ou de gardiens forestiers au cœur des forêts.
	}

	SignalTowerDecryptionAutoPlay: {
		Label: Décryptage automatique des tours de signal
		Tooltip: ""
	}
}
