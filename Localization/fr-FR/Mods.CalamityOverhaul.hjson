	Items: {
		ArcaneTransformer: {
			DisplayName: Transformateur arcanique
			Tooltip: ""
		}
	}
}

Resurrections: {
	ResurrectionDeath: {
		DeathText: "{0} a succombé à la résurrection abyssale"
		WarningCombatText: L'Abîme vous consume...
		DeathNoticeText: Vous avez été consumé par l'Abîme...
		MarkRemainText: La marque de l'Abîme vous enlace encore...
		RetainValueFormat: Valeur de résurrection: {0}%
	}
}

QuickHack: {
	SynapseBurn: {
		DisplayName: Surcharge synaptique
		Description: Surchauffe les synapses neuronales de la cible, infligeant des dégâts thermiques continus.
	}

	ShortCircuit: {
		DisplayName: Court-circuit
		Description: Déclenche une impulsion EMP infligeant des dégâts instantanés et une brève paralysie.
	}

	Cyberpsychosis: {
		DisplayName: Cyberpsychose
		Description: Plonge la cible dans une frénésie, l'amenant à attaquer toutes les unités proches.
	}

	SystemReset: {
		DisplayName: Réinitialisation système
		Description: Force un redémarrage du système de la cible, la paralysant complètement.
	}

	OpticOverload: {
		DisplayName: Surcharge optique
		Description: Aveugle la cible, l'empêchant de percevoir son environnement.
	}

	MemoryWipe: {
		DisplayName: Effacement de mémoire
		Description: Efface les données d'hostilité de la cible et réinitialise son agressivité.
	}

	Contagion: {
		DisplayName: Contagion
		Description: Implante un malware auto-réplicatif qui se propage aux cibles proches.
	}

	TileDetonate: {
		DisplayName: Détonation structurelle
		Description: Compromet l'intégrité structurelle et déclenche une explosion localisée.
	}

	TilePhase: {
		DisplayName: Protocole de phase
		Description: Modifie les propriétés physiques d'un bloc, le rendant intangible pendant un certain temps.
	}

	TileMagPull: {
		DisplayName: Attraction magnétique
		Description: Génère un champ magnétique attirant les objets proches vers vous.
	}

	MachineShortCircuit: {
		DisplayName: Court-circuit mécanique
		Description: Vide l'énergie de la machine cible et libère des arcs électriques endommageant les entités proches.
	}

	TurretHijack: {
		DisplayName: Piratage de tourelle
		Description: Altère le module d'identification IFF, inversant temporairement l'identification allié/ennemi de la tourelle.
	}

	FalseMemory: {
		DisplayName: Faux souvenir
		Description: Implante de faux souvenirs, interrompant brièvement la poursuite ou supprimant le schéma meurtrier de la cible.
	}

	SelfDismember: {
		DisplayName: Auto-démembrement
		Description: Force l'entité paranormale à se mutiler elle-même.
	}

	SystemHalt: {
		DisplayName: Arrêt système
		Description: Force brièvement la cible à cesser toute activité.
	}

	TurretCircuitOverload: {
		DisplayName: Surcharge de circuit
		Description: Injecte un courant inversé dans le circuit d'alimentation de la tourelle, la désactivant complètement pendant une longue durée.
	}

	TurretShortCircuit: {
		DisplayName: Court-circuit de tourelle
		Description: Décharge instantanément l'énergie de la tourelle afin de l'interrompre brièvement avant sa remise en ligne.
	}

	VirusBroadcast: {
		DisplayName: Diffusion virale
		Description: Injecte un ver informatique dans la tour de signal, provoquant l'émission d'ondes EMP cybernétiques qui court-circuitent toutes les tourelles à portée pendant une longue durée.
	}
}

